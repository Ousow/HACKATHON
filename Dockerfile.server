# ~~image de base identique a l ocr-app pour avoir poppler et tesseract
FROM python:3.11-slim

WORKDIR /app

# ~~installation de poppler et tesseract (necessaires pour pdf2image et pytesseract)
RUN apt-get update && apt-get install -y \
    tesseract-ocr \
    tesseract-ocr-fra \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# ~~installation des dependances python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN pip install --no-cache-dir flask flask-cors

# ~~copie du serveur Flask et du module OCR
COPY server.py .
COPY ocr-app/app/ ./ocr-app/app/

EXPOSE 5000

CMD ["python", "server.py"]