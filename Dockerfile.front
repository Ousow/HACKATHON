# ~~etape 1 : build de l application Vite
FROM node:20-alpine AS builder

WORKDIR /app

COPY front/package*.json ./
RUN npm install

COPY front/ .
RUN npm run build

# ~~etape 2 : serveur nginx leger pour servir les fichiers statiques
FROM nginx:alpine

# ~~copie du build vite vers nginx
COPY --from=builder /app/dist /usr/share/nginx/html

# ~~configuration nginx pour le routing react (toutes les routes -> index.html)
RUN echo 'server { \
    listen 80; \
    location / { \
        root /usr/share/nginx/html; \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80